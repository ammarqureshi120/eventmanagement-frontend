{
  "name": "eventhub-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "cross-env TZ=UTC vitest run",
    "test:watch": "cross-env TZ=UTC vitest",
    "e2e": "cross-env TZ=UTC playwright test",
    "api:generate": "node scripts/clean-generated.mjs && rtk-query-codegen-openapi openapi-config.ts",
    "api:check": "npm run api:generate && node scripts/check-drift.mjs src/api/generated",
    "audit": "npm audit --audit-level=moderate",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "ci": "npm run lint && npm run typecheck && npm run api:check && npm run test && npm run build && npm run e2e && npm run audit"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/nunito-sans": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@reduxjs/toolkit": "2.12.0",
    "@tailwindcss/vite": "4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "0.4.0",
    "date-fns": "4.4.0",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-redux": "9.3.0",
    "react-router": "8.4.0",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10",
    "@playwright/test": "1.63.0",
    "@rtk-query/codegen-openapi": "2.2.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "cross-env": "10.1.0",
    "esbuild": "0.28.2",
    "esbuild-runner": "2.2.2",
    "eslint": "10.11.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
